{
  "manifest_version": 3,
  "name": "Steam Wishlist Rank",
  "version": "0.2.0",
  "description": "Shows Steam Popular Wishlisted rank and estimated wishlist count on Steam app pages.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://nicksoin.github.io/SteamTopWishlistsRank/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*"],
      "js": ["src/shared.js", "src/content-steam.js"],
      "css": ["src/steam-wishlist-rank.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Steam Wishlist Rank"
  }
}
